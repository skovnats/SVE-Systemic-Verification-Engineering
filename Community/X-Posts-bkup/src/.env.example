# ─────────────────────────────────────────────────────────────────
# X (Twitter) API Credentials
# Получить здесь: https://developer.twitter.com/en/portal/dashboard
# ─────────────────────────────────────────────────────────────────

# ОБЯЗАТЕЛЬНО: Bearer Token (есть на всех тарифах, включая Free)
X_BEARER_TOKEN=ваш_bearer_token_сюда

# ЖЕЛАТЕЛЬНО: нужны для доступа к приватным твитам и
#             более высоким лимитам (OAuth 1.0a User Context)
X_API_KEY=ваш_api_key
X_API_SECRET=ваш_api_secret
X_ACCESS_TOKEN=ваш_access_token
X_ACCESS_SECRET=ваш_access_secret

# ─────────────────────────────────────────────────────────────────
# ТАРИФЫ X API (на июнь 2025):
#
#   Free   — только запись (1 500 твитов/мес), чтение очень ограничено
#   Basic  — $100/мес, 10 000 прочтений/мес, своя лента доступна
#   Pro    — $5 000/мес, 1 000 000 прочтений/мес
#
# Для бэкапа своих твитов нужен минимум Basic + OAuth 1.0a.
#
# АЛЬТЕРНАТИВА без API:
#   Настройки X → Конфиденциальность → Аккаунт → 
#   "Скачать архив данных" — даёт ВСЕ твиты бесплатно.
#   Но тогда нужен другой парсер (работает с tweets.js из архива).
# ─────────────────────────────────────────────────────────────────
