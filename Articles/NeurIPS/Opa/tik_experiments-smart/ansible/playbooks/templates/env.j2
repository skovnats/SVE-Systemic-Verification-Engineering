# TIK Experiments - Environment Configuration
# Generated by Ansible - {{ ansible_date_time.iso8601 }}
# С Богом!

# ========================================
#          CONNECTION SETTINGS
# ========================================

# Redis
REDIS_URL={{ redis_url }}

# PostgreSQL
DATABASE_URL=postgresql://{{ postgres_user }}:{{ vault_postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}

# Celery
CELERY_BROKER_URL={{ celery_broker_url }}
CELERY_RESULT_BACKEND={{ celery_result_backend }}

# ========================================
#          PROVIDER STRATEGY
# ========================================

# FREE-FIRST: Use g4f (free) before OpenRouter (paid)
PROVIDER_STRATEGY=free_first

# OpenRouter (for PAID tier and ARBITER)
OPENROUTER_API_KEY={{ vault_openrouter_api_key }}

# ARBITER: Opus 4.5 (use sparingly!)
USE_ARBITER=true
ARBITER_MODEL={{ llm_config.arbiter.model | default('anthropic/claude-opus-4') }}
ARBITER_TEMPERATURE={{ llm_config.arbiter.temperature | default(0.3) }}

# When to escalate to ARBITER
DISAGREEMENT_THRESHOLD={{ experiment.disagreement_threshold | default(0.66) }}
VERIFICATION_THRESHOLD={{ experiment.verification_threshold | default(0.85) }}

# ========================================
#          WORKER SETTINGS
# ========================================

# Worker identity
WORKER_HOST={{ inventory_hostname }}
CELERY_CONCURRENCY={{ celery_concurrency | default(4) }}

# Logging
LOG_LEVEL={{ log_level | default('INFO') }}

# ========================================
#          G4F FREE PROVIDERS
# ========================================
# Priority order (lower = try first)
G4F_PROVIDERS=Bing,You,Phind,DeepInfra,Groq,HuggingChat
G4F_MAX_FAILURES=5

# ========================================
#          VPN SETTINGS
# ========================================
{% if use_vpn | default(false) %}
USE_VPN=true
VPN_INTERFACE={{ vpn_interface | default('wg0') }}
{% endif %}
