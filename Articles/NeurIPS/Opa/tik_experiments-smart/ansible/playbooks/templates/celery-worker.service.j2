# TIK Experiments - Celery Worker Service
# Generated by Ansible
# С Богом!

[Unit]
Description=TIK Experiments Celery Worker ({{ inventory_hostname }})
After=network.target redis.service

[Service]
Type=simple
User={{ ansible_user }}
Group={{ ansible_user }}
WorkingDirectory={{ project_dir }}/src
Environment="PATH={{ venv_path }}/bin"
EnvironmentFile={{ project_dir }}/.env

ExecStart={{ venv_path }}/bin/celery \
    -A smart_tasks worker \
    --loglevel={{ celery_log_level | default('info') }} \
    --concurrency={{ celery_concurrency | default(4) }} \
    --hostname={{ inventory_hostname }}@%%h \
    --queues=default,free_tier,paid_tier,arbiter

Restart=always
RestartSec=10

# Logging
StandardOutput=append:{{ log_dir }}/celery-worker.log
StandardError=append:{{ log_dir }}/celery-worker.err

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
