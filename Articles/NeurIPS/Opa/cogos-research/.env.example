# CogOS Research - Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# API KEYS
# =============================================================================

# OpenAI (required for GPT-4 baselines)
OPENAI_API_KEY=sk-your-key-here

# Anthropic (required for Constitutional AI baseline and Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Together AI (optional, for open models like Llama)
TOGETHER_API_KEY=your-key-here

# HuggingFace (for datasets and models)
HF_TOKEN=hf_your-token-here

# =============================================================================
# PATHS
# =============================================================================

# Data directory
DATA_DIR=./data

# Results directory
RESULTS_DIR=./results

# Checkpoints
CHECKPOINTS_DIR=./checkpoints

# =============================================================================
# COMPUTE
# =============================================================================

# GPU device (cuda:0, cuda:1, cpu)
DEVICE=cuda:0

# Batch size
BATCH_SIZE=32

# Number of workers for data loading
NUM_WORKERS=4

# =============================================================================
# LOGGING
# =============================================================================

# Weights & Biases (optional)
WANDB_API_KEY=your-key-here
WANDB_PROJECT=cogos-research
WANDB_ENTITY=your-username

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# HUMAN EVALUATION
# =============================================================================

# Prolific (for human evaluation)
PROLIFIC_API_KEY=your-key-here

# MTurk (alternative)
AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here
MTURK_SANDBOX=true  # Set to false for production

# =============================================================================
# EXPERIMENT TRACKING
# =============================================================================

# Random seed for reproducibility
RANDOM_SEED=42

# Max API retries
MAX_RETRIES=3

# Rate limiting (requests per minute)
RATE_LIMIT=60
